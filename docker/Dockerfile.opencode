# OpenCode runner image (separate from web UI)
ARG OPENCODE_BASE_IMAGE=node:20-slim
FROM ${OPENCODE_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/opencode \
    NPM_CONFIG_REGISTRY="https://registry.npmmirror.com" \
    NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=2000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=30000 \
    NPM_CONFIG_FETCH_TIMEOUT=300000

# Use CN mirrors by default (override with build args if needed).
ARG APT_MIRROR="http://mirrors.tuna.tsinghua.edu.cn/debian"
ARG APT_SECURITY_MIRROR="http://mirrors.tuna.tsinghua.edu.cn/debian-security"
ARG NPM_REGISTRY_CANDIDATES="https://registry.npmmirror.com https://mirrors.cloud.tencent.com/npm https://mirrors.huaweicloud.com/repository/npm https://registry.npmjs.org"

# Best-effort: rewrite Debian apt sources to CN mirrors.
RUN set -e; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
      [ -f "$f" ] || continue; \
      sed -i -E "s#https?://deb.debian.org/debian#${APT_MIRROR}#g" "$f"; \
      sed -i -E "s#https?://security.debian.org/debian-security#${APT_SECURITY_MIRROR}#g" "$f"; \
      sed -i -E "s#https?://security.debian.org/debian#${APT_SECURITY_MIRROR}#g" "$f"; \
    done

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        make \
        g++ \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 opencode \
    && useradd -m -d /home/opencode -u 10001 -g 10001 -s /bin/bash opencode

ARG NPM_REGISTRY_CANDIDATES
RUN set -eux; \
    npm config set fetch-retries "$NPM_CONFIG_FETCH_RETRIES"; \
    npm config set fetch-retry-factor "$NPM_CONFIG_FETCH_RETRY_FACTOR"; \
    npm config set fetch-retry-mintimeout "$NPM_CONFIG_FETCH_RETRY_MINTIMEOUT"; \
    npm config set fetch-retry-maxtimeout "$NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT"; \
    npm config set fetch-timeout "$NPM_CONFIG_FETCH_TIMEOUT"; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64|x86_64) opencode_pkg="opencode-linux-x64" ;; \
      arm64|aarch64) opencode_pkg="opencode-linux-arm64" ;; \
      *) echo "Unsupported architecture for OpenCode: $arch" >&2; exit 1 ;; \
    esac; \
    selected=""; \
    tarball_url=""; \
    for r in $NPM_REGISTRY_CANDIDATES; do \
      echo "[npm] resolving ${opencode_pkg} via registry: $r"; \
      candidate="$(npm --registry "$r" --fetch-timeout=12000 --loglevel=error view "$opencode_pkg" dist.tarball 2>/dev/null | tail -n 1 | tr -d '\"')"; \
      if [ -n "$candidate" ]; then \
        selected="$r"; \
        tarball_url="$candidate"; \
        echo "[npm] selected registry: $selected"; \
        break; \
      fi; \
      echo "[npm] registry $r missing $opencode_pkg, trying next"; \
    done; \
    if [ -z "$tarball_url" ]; then \
      echo "[npm] failed to resolve tarball for $opencode_pkg from any candidate registry"; \
      exit 1; \
    fi; \
    npm config set registry "$selected"; \
    tmp_dir="$(mktemp -d)"; \
    curl --retry 5 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 180 \
      -fsSL "$tarball_url" -o "${tmp_dir}/opencode.tgz"; \
    tar -xzf "${tmp_dir}/opencode.tgz" -C "${tmp_dir}"; \
    install -m 0755 "${tmp_dir}/package/bin/opencode" /usr/local/bin/opencode; \
    rm -rf "${tmp_dir}"; \
    command -v opencode; \
    opencode --version

# Create opencode config with Qwen models (simplified format without $schema)
RUN mkdir -p /home/opencode/.opencode && \
    echo '{"provider":{"openrouter":{"models":{"qwen/qwen3-max-thinking":{},"qwen/qwen3-max":{},"qwen/qwen3-coder-plus":{}}}}}' \
    > /home/opencode/.opencode/config.json && \
    chown -R 10001:10001 /home/opencode /repo

WORKDIR /repo
USER 10001:10001
CMD ["opencode", "run"]
